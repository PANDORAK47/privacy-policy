# Claude(LLM)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
# (선택) 설계서 9.1 모델 라우팅: 추출 단계만 다른 모델로 지정 가능
# CLAUDE_EXTRACT_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=16000

# 공공데이터(식약처/식품안전나라) 인증키 — 없으면 원료조회는 내장 MOCK 으로 동작
MFDS_SERVICE_KEY=
# 수입식품 원료정보 API (정확한 base/serviceId/파라미터는 데이터셋 명세로 확인 필요)
# data.go.kr 15111777 / 식품안전나라 OpenAPI
MFDS_INGREDIENT_API_BASE=http://openapi.foodsafetykorea.go.kr/api
MFDS_INGREDIENT_SERVICE_ID=

# 강제 MOCK 모드(키가 있어도 오프라인 데모를 원할 때)
USE_MOCK=
