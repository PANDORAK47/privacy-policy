# Claude(LLM)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
# (선택) 설계서 9.1 모델 라우팅: 추출 단계만 다른 모델로 지정 가능
# CLAUDE_EXTRACT_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=16000

# 공공데이터 — 식품안전나라 OpenAPI 단일 연동
# 인증키(식품안전나라/공공데이터포털에서 발급). 없으면 모든 조회는 MOCK.
MFDS_SERVICE_KEY=
MFDS_API_BASE=https://openapi.foodsafetykorea.go.kr/api

# 데이터셋별 서비스ID(명세에서 확인 후 입력). 미입력 시 해당 조회는 MOCK.
#   수입식품 원료정보(공공데이터포털 15111777)
MFDS_INGREDIENT_SERVICE_ID=
#   식품첨가물 기준·규격(15116583)
MFDS_ADDITIVE_SERVICE_ID=
#   농약 잔류허용기준 MRL(15074323)
MFDS_PESTICIDE_SERVICE_ID=
#   수입식품 회수·판매중지(15095378) 또는 식품 회수·판매중지(15074318)
MFDS_RECALL_SERVICE_ID=

# (선택) 검색 요청변수명 — 명세 확인 후 보정. 기본값은 흔한 후보명.
# MFDS_INGREDIENT_QUERY_FIELD=PRDLST_NM
# MFDS_ADDITIVE_QUERY_FIELD=NM
# MFDS_PESTICIDE_QUERY_FIELD=PRES_NM
# MFDS_RECALL_QUERY_FIELD=PRDLST_NM

# ───────────────────────────────────────────────────────────────
# 옵션 B (권장): 공공데이터포털(data.go.kr) REST 직접 호출
#   - 원료 등은 DATA_GO_KR_API_KEY(공공데이터포털 키)로 호출합니다.
#     (setup_local.py 가 ifacs-unified 에서 자동으로 채워줍니다.)
#   - 아래 *_DATAGO_URL 에 "이미 정상 동작하는 ifacs-unified 의 그 주소"를 넣으면,
#     해당 조회는 식품안전나라 대신 data.go.kr 을 사용합니다(우선순위: data.go.kr → 식품안전나라 → MOCK).
#       예) https://apis.data.go.kr/1471000/<서비스>/<오퍼레이션>
#           https://api.odcloud.kr/api/15111777/v1/uddi:<uuid>
#   - 인증: serviceKey 파라미터로 자동 첨부. 응답의 items[]/data[]/row[] 에서 row 자동 추출.
DATA_GO_KR_API_KEY=
INGREDIENT_DATAGO_URL=
# ADDITIVE_DATAGO_URL=
# PESTICIDE_DATAGO_URL=
# RECALL_DATAGO_URL=
# (선택) data.go.kr 검색 요청변수명 — 응답/명세에 맞게 보정(미지정 시 위 MFDS_* 후보 사용).
# INGREDIENT_DATAGO_QUERY_FIELD=PRDLST_NM
# ───────────────────────────────────────────────────────────────

# 강제 MOCK 모드(키가 있어도 오프라인 데모를 원할 때)
USE_MOCK=

# ───────────────────────────────────────────────────────────────
# ⚠️ 네트워크 egress 허용목록(원격 실행 환경)에 아래 호스트를 추가해야
#    실제 API 호출이 가능합니다(미추가 시 "Host not in allowlist" 403):
#      openapi.foodsafetykorea.go.kr   (식품안전나라 OpenAPI)
#      api.anthropic.com               (Claude 추출/에이전트 사용 시)
#      apis.data.go.kr / api.odcloud.kr (data.go.kr REST 직접 호출 시)
#      unipass.customs.go.kr           (관세청 HS/요건, 확장 시)
# ───────────────────────────────────────────────────────────────
