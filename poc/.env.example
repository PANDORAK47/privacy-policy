# Claude(LLM)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
# (선택) 설계서 9.1 모델 라우팅: 추출 단계만 다른 모델로 지정 가능
# CLAUDE_EXTRACT_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=16000

# 공공데이터 — 식품안전나라 OpenAPI 단일 연동
# 인증키(식품안전나라/공공데이터포털에서 발급). 없으면 모든 조회는 MOCK.
MFDS_SERVICE_KEY=
MFDS_API_BASE=https://openapi.foodsafetykorea.go.kr/api

# 데이터셋별 서비스ID(명세에서 확인 후 입력). 미입력 시 해당 조회는 MOCK.
#   수입식품 원료정보(공공데이터포털 15111777)
MFDS_INGREDIENT_SERVICE_ID=
#   식품첨가물 기준·규격(15116583)
MFDS_ADDITIVE_SERVICE_ID=
#   농약 잔류허용기준 MRL(15074323)
MFDS_PESTICIDE_SERVICE_ID=
#   수입식품 회수·판매중지(15095378) 또는 식품 회수·판매중지(15074318)
MFDS_RECALL_SERVICE_ID=

# 강제 MOCK 모드(키가 있어도 오프라인 데모를 원할 때)
USE_MOCK=
